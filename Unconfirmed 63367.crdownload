import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from sklearn.metrics import r2_score
import warnings
warnings.filterwarnings("ignore")

exec(open("load_all_simple.py").read())

# fix double-space column names in table3
table3.columns = [c.replace("  ", " ").strip() for c in table3.columns]

# helper: pull a single indicator row from table1 as a clean numeric series
year_cols = [c for c in table1.columns if c != "characteristic"]

def get_series(keyword):
    mask = table1["characteristic"].str.contains(keyword, case=False, na=False)
    row = table1[mask]
    if row.empty:
        return None, None
    vals = pd.to_numeric(row[year_cols].iloc[0], errors="coerce")
    return year_cols, vals

print("=" * 65)
print("STUDY OF INDUSTRIAL GROWTH AND PERFORMANCE — FULL ANALYSIS")
print("=" * 65)


# =====================================================================
# PART 1: EDA — understand what the data contains
