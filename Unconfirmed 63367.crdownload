print("\n--- PART 1: EDA ---\n")

# 1a. Basic summary stats for Table 2 (industry snapshot 2023-24)
print("Table 2 — Industry summary stats (2023-24):")
print(table2[["Total Output", "Net Value Added", "Workers", "Fixed Capital"]].describe().round(0))

# 1b. Missing values across all tables
print("\nMissing values:")
print("  Table 1:", table1[year_cols].isna().sum().sum(), "cells")
print("  Table 2:", table2.isna().sum().sum(), "cells")
print("  Table 3:", table3.isna().sum().sum(), "cells")
print("  Table 5:", table5.isna().sum().sum(), "cells")

# 1c. Share of top 5 industries in national NVA
total_nva = table2["Net Value Added"].sum()
top5 = table2.nlargest(5, "Net Value Added")
print(f"\nTop 5 industries' share of total NVA: {top5['Net Value Added'].sum()/total_nva*100:.1f}%")
print(top5[["Industry_Description", "Net Value Added"]].to_string(index=False))

# 1d. Derived metrics on Table 2
table2["NVA_per_worker"]    = table2["Net Value Added"] / table2["Workers"]
table2["Output_per_worker"] = table2["Total Output"]    / table2["Workers"]
table2["Capital_intensity"] = table2["Fixed Capital"]   / table2["Workers"]

print("\nHighest labour productivity (NVA per worker, Rs. Lakh):")
print(table2.nlargest(5, "NVA_per_worker")[["Industry_Description", "NVA_per_worker"]].to_string(index=False))


