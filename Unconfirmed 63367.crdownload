ax = axes[1, 0]
ax.plot(years, workers_vals.values, color="#2ca02c", marker="o", markersize=3)
ax.set_title("Number of Workers")
ax.set_ylabel("Persons")
ax.set_xticks(tick_labels); ax.set_xticklabels(tick_labels, rotation=45, ha="right")
ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f"{x/1e6:.1f}M"))

ax = axes[1, 1]
