_, capital_vals    = get_series("FIXED  CAPITAL")

fig, axes = plt.subplots(2, 2, figsize=(16, 10))
fig.suptitle("India Industrial Trends, 1981-82 to 2023-24", fontsize=14, fontweight="bold")

tick_idx = list(range(0, len(years), 5))
tick_labels = [years[i] for i in tick_idx]

ax = axes[0, 0]
ax.plot(years, output_vals.values, color="#1f77b4", marker="o", markersize=3)
ax.set_title("Value of Output")
