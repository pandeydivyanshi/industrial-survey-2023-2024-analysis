print("\n" + "=" * 65)
print("PART 3: INTERPRETATION")
print("=" * 65)

# compute CAGR helper
def cagr(vals, n_years):
    v = vals.dropna()
    if len(v) < 2 or v.iloc[0] <= 0:
        return np.nan
    return ((v.iloc[-1] / v.iloc[0]) ** (1 / n_years) - 1) * 100

n = len(years) - 1

print(f"""
OBJECTIVE 1 — Production levels across industries (2023-24):
  • Basic Metals is the top industry by NVA (Rs. {top5.iloc[0]['Net Value Added']/1e6:.1f}M lakh),
    followed by Motor Vehicles, Chemicals, Pharmaceuticals, and Machinery.
  • Top 5 industries alone account for {top5['Net Value Added'].sum()/total_nva*100:.1f}% of
    total industrial Net Value Added — high concentration.
  • Salt Production, Publishing, and Waste Management are the
    smallest contributors (below Rs. 500K lakh NVA each).

OBJECTIVE 2 — Trends in output, employment, investment (1981-2024):
  • Value of Output CAGR: {cagr(output_vals, n):.2f}% per year (nominal)
  • Net Value Added CAGR: {cagr(nva_vals, n):.2f}% per year (nominal)
  • Fixed Capital CAGR:   {cagr(capital_vals, n):.2f}% per year (nominal)
  • Workers CAGR:         {cagr(workers_vals, n):.2f}% per year
  → Key finding: Output and Capital grew ~{cagr(output_vals,n)/cagr(workers_vals,n):.1f}x faster
    than employment — Indian industry is increasingly capital-
    intensive, not labour-intensive. Growth in output is driven
    by investment, not by hiring more workers.
  → COVID impact visible: output dipped in 2019-20 to 2020-21,
    followed by the sharpest single-year recovery in the entire
    43-year series (2021-22 to 2023-24).

OBJECTIVE 3 — Sectors contributing most to growth:
  • Manufacturing dominates: Basic Metals, Motor Vehicles,
    Chemicals, Pharma, and Machinery are the top 5 by NVA.
  • Pharma and Electronics show strong growth potential —
    both are high-value, capital-intensive sectors with
    government policy tailwinds (PLI schemes).
  • Labour-intensive sectors (Textiles, Wearing Apparel,
    Food Products) rank in the mid-tier by NVA but employ
    significantly more workers than capital-heavy sectors.
  • State concentration: Maharashtra + Gujarat + Tamil Nadu
    together account for ~{table3[table3['State'].isin(['Maharashtra','Gujarat','Tamil Nadu'])]['Net Value Added'].sum() / table3['Net Value Added'].sum()*100:.0f}% of total NVA — 
    regional imbalance is significant.

NOTE: All monetary figures are in current prices (nominal Rs. Lakh).
Real growth would be lower after adjusting for inflation. This is
standard for ASI published tables — deflators are not included.
""")


# =====================================================================
# PART 4: PREDICTIVE MODEL — Future output growth
# =====================================================================
print("=" * 65)
print("PART 4: PREDICTIVE MODEL")
print("=" * 65)

# Use Table 1's VALUE OF OUTPUT time series as the target
# Model: Polynomial regression (degree 2) on year index
# Forecast: next 5 years (2024-25 to 2028-29)
# Limitation: nominal values only, no structural breaks modelled

y_vals = output_vals.values.astype(float)
x_idx  = np.arange(len(y_vals)).reshape(-1, 1)

# drop NaN years (early 1980s had missing data)
valid = ~np.isnan(y_vals)
x_fit = x_idx[valid]
y_fit = y_vals[valid]

# polynomial regression degree 2
poly = PolynomialFeatures(degree=2)
x_poly = poly.fit_transform(x_fit)
model = LinearRegression()
model.fit(x_poly, y_fit)

y_pred_in  = model.predict(x_poly)
r2         = r2_score(y_fit, y_pred_in)
print(f"\nPolynomial regression (degree 2) R² = {r2:.4f}")

# forecast next 5 years
n_forecast  = 5
future_idx  = np.arange(len(y_vals), len(y_vals) + n_forecast).reshape(-1, 1)
future_poly = poly.transform(future_idx)
y_future    = model.predict(future_poly)

# construct future year labels
last_year   = years[-1]                       # e.g. "2023-24"
start       = int(last_year.split("-")[0])
future_years = [f"{start+i+1}-{str(start+i+2)[-2:]}" for i in range(n_forecast)]

print("\nForecasted Value of Output (Rs. Lakh):")
for yr, val in zip(future_years, y_future):
    print(f"  {yr}: {val:,.0f}")

# plot: actual + fitted + forecast
fig, ax = plt.subplots(figsize=(14, 6))
ax.plot(years, y_vals, "o-", color="#1f77b4", markersize=3, label="Actual", zorder=3)
ax.plot(np.array(years)[valid], y_pred_in, "--", color="orange",
        linewidth=2, label=f"Fitted (R²={r2:.3f})")
ax.plot(future_years, y_future, "s--", color="red", markersize=6,
        linewidth=2, label="Forecast (2024-2029)")

# shade forecast region
ax.axvspan(years[-1], future_years[-1], alpha=0.08, color="red", label="Forecast period")

all_labels = years + future_years
tick_idx2  = list(range(0, len(all_labels), 5))
ax.set_xticks([all_labels[i] for i in tick_idx2])
ax.set_xticklabels([all_labels[i] for i in tick_idx2], rotation=45, ha="right")
ax.set_ylabel("Rs. Lakh")
ax.set_title("India Industrial Output — Actual vs Forecast (Polynomial Regression)")
ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f"{x/1e6:.1f}M"))
ax.legend()
plt.tight_layout()
plt.savefig("viz_forecast.png", dpi=130)
plt.show()
print("Saved: viz_forecast.png")

print(f"""
Model notes:
  • Polynomial regression (degree 2) fitted on the full 43-year
    series (1981-82 to 2023-24). R² = {r2:.4f} (excellent fit).
  • Forecasts are for nominal output only — real growth depends
    on inflation trends not modelled here.
  • The sharp post-COVID recovery (2021-24) inflates the short-
    term forecast upward — treat as an upper-bound estimate.
  • For a more robust model, additional features like GDP growth,
    capital formation, or policy shocks would improve accuracy.
    For this project scope, polynomial trend is appropriate.
""")

print("ANALYSIS COMPLETE.")
print("Charts saved: viz_trends_4panel.png, viz_industry_nva.png,")
print("              viz_scatter_productivity.png, viz_state_nva.png,")
print("              viz_nva_pie.png, viz_forecast.png")
